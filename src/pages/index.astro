---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta
      name="description"
      content="Community Baptist Church South Sudan — a growing Christian church family serving Aweil and communities across the Bahr el Ghazal region."
    />

    <meta
      name="keywords"
      content="Community Baptist Church South Sudan, CBC South Sudan, Baptist Church Aweil, church Aweil, South Sudan church"
    />

    <meta
      property="og:title"
      content="Community Baptist Church South Sudan"
    />

    <meta
      property="og:description"
      content="Growing in faith, serving in love and reaching communities."
    />

    <meta
      property="og:type"
      content="website"
    />

    <title>Community Baptist Church South Sudan</title>

    <link
      rel="icon"
      type="image/png"
      href="/images/community-baptist-church-south-sudan-final-favicon.png"
    />

    <style>
      :root {
        --primary: #0b4f8a;
        --primary-dark: #07385f;
        --secondary: #f39c12;
        --dark: #102a43;
        --text: #435466;
        --muted: #6b7b8c;
        --light: #f5f8fb;
        --white: #ffffff;
        --border: #e5ebf1;
        --shadow: 0 15px 40px rgba(16, 42, 67, 0.1);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family:
          Arial,
          Helvetica,
          sans-serif;
        color: var(--text);
        background: var(--white);
        line-height: 1.75;
      }

      img {
        max-width: 100%;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .container {
        width: min(1180px, 92%);
        margin: 0 auto;
      }

      .section {
        padding: 100px 0;
      }

      .section-title {
        max-width: 800px;
        margin: 0 auto 55px;
        text-align: center;
      }

      .section-title span {
        display: inline-block;
        margin-bottom: 10px;
        color: var(--secondary);
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2.5px;
        text-transform: uppercase;
      }

      .section-title h2 {
        margin-bottom: 17px;
        color: var(--dark);
        font-size: clamp(2.15rem, 4vw, 3.2rem);
        line-height: 1.15;
        letter-spacing: -0.5px;
      }

      .section-title p {
        color: var(--muted);
        font-size: 1.04rem;
      }

      /* HEADER */

      header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 2px 18px rgba(0, 0, 0, 0.07);
      }

      .nav {
        min-height: 86px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
      }

      .brand img {
        width: 66px;
        height: 66px;
        object-fit: contain;
      }

      .brand-text {
        line-height: 1.2;
      }

      .brand-text strong {
        display: block;
        color: var(--primary);
        font-size: 1.02rem;
        font-weight: 800;
      }

      .brand-text small {
        display: block;
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.75rem;
      }

      nav {
        display: flex;
        align-items: center;
        gap: 23px;
      }

      nav a {
        color: var(--dark);
        font-size: 0.9rem;
        font-weight: 700;
        transition: 0.25s ease;
      }

      nav a:hover {
        color: var(--secondary);
      }

      .nav-donate {
        padding: 10px 18px;
        border-radius: 5px;
        background: var(--primary);
        color: white !important;
      }

      .nav-donate:hover {
        background: var(--secondary);
      }

      /* HERO */

      .hero {
        position: relative;
        min-height: 700px;
        overflow: hidden;
        background: #071d2d;
      }

      .hero-slide {
        position: absolute;
        inset: 0;
        visibility: hidden;
        opacity: 0;
        transition:
          opacity 0.9s ease,
          visibility 0.9s ease;
      }

      .hero-slide.active {
        visibility: visible;
        opacity: 1;
      }

      .hero-slide::before {
        content: "";
        position: absolute;
        inset: -30px;
        background-image: var(--hero-bg);
        background-position: center;
        background-size: cover;
        filter: blur(15px);
        transform: scale(1.08);
        opacity: 0.42;
      }

      .hero-slide::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            90deg,
            rgba(4, 24, 42, 0.94) 0%,
            rgba(4, 24, 42, 0.78) 42%,
            rgba(4, 24, 42, 0.25) 100%
          );
      }

      .hero-image {
        position: absolute;
        z-index: 1;
        top: 3%;
        right: 5%;
        width: 53%;
        height: 94%;
        object-fit: cover;
        object-position: center;
        border-radius: 5px;
        box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      }

      .hero-slide.portrait .hero-image {
        right: 5%;
        width: 48%;
        height: 94%;
        object-fit: contain;
      }

      .hero-content {
        position: relative;
        z-index: 3;
        min-height: 700px;
        display: flex;
        align-items: center;
      }

      .hero-copy {
        width: 49%;
        padding: 70px 0;
        color: white;
      }

      .hero-copy span {
        display: inline-block;
        margin-bottom: 17px;
        color: var(--secondary);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 2.2px;
        text-transform: uppercase;
      }

      .hero-copy h1 {
        margin-bottom: 25px;
        color: white;
        font-size: clamp(2.8rem, 5vw, 5rem);
        line-height: 1.04;
        letter-spacing: -1.5px;
      }

      .hero-copy p {
        max-width: 600px;
        margin-bottom: 31px;
        color: rgba(255, 255, 255, 0.91);
        font-size: 1.1rem;
      }

      .hero-scripture {
        max-width: 520px;
        margin-bottom: 28px;
        padding-left: 18px;
        border-left: 3px solid var(--secondary);
        color: rgba(255, 255, 255, 0.92);
        font-size: 0.95rem;
        font-style: italic;
      }

      .hero-scripture strong {
        display: block;
        margin-top: 5px;
        color: var(--secondary);
        font-size: 0.78rem;
        font-style: normal;
        letter-spacing: 0.5px;
      }

      .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 23px;
        border-radius: 5px;
        font-weight: 800;
        transition: 0.25s ease;
      }

      .btn-primary {
        background: var(--secondary);
        color: white;
      }

      .btn-primary:hover {
        background: #d88708;
        transform: translateY(-2px);
      }

      .btn-outline {
        border: 1px solid rgba(255, 255, 255, 0.65);
        color: white;
      }

      .btn-outline:hover {
        background: white;
        color: var(--primary);
      }

      .hero-controls {
        position: absolute;
        z-index: 5;
        bottom: 30px;
        left: 4%;
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .hero-arrow {
        width: 42px;
        height: 42px;
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.25);
        color: white;
        cursor: pointer;
        font-size: 1.05rem;
      }

      .hero-arrow:hover {
        border-color: var(--secondary);
        background: var(--secondary);
      }

      .hero-dots {
        display: flex;
        gap: 7px;
        margin-left: 8px;
      }

      .hero-dot {
        width: 8px;
        height: 8px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.5);
        cursor: pointer;
      }

      .hero-dot.active {
        background: var(--secondary);
        transform: scale(1.35);
      }

      /* STATS */

      .welcome {
        background: white;
      }

      .stats {
        position: relative;
        z-index: 10;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-top: -55px;
      }

      .stat {
        padding: 31px 20px;
        border-radius: 8px;
        background: white;
        text-align: center;
        box-shadow: var(--shadow);
      }

      .stat strong {
        display: block;
        margin-bottom: 5px;
        color: var(--primary);
        font-size: 2.45rem;
        line-height: 1.1;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.88rem;
        font-weight: 600;
      }

      /* STORY */

      .story {
        background: var(--light);
      }

      .story-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 70px;
        align-items: center;
      }

      .story-image img {
        width: 100%;
        height: 530px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: var(--shadow);
      }

      .story-content .eyebrow {
        margin-bottom: 8px;
        color: var(--secondary);
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .story-content h2 {
        margin-bottom: 21px;
        color: var(--dark);
        font-size: clamp(2.1rem, 4vw, 3.1rem);
        line-height: 1.15;
      }

      .story-content p {
        margin-bottom: 18px;
      }

      .story-highlight {
        margin: 27px 0;
        padding: 17px 0 17px 20px;
        border-left: 4px solid var(--secondary);
        color: var(--dark);
        font-size: 1.03rem;
        font-weight: 700;
      }

      .scripture-box {
        margin: 27px 0;
        padding: 22px 24px;
        border-radius: 7px;
        background: white;
        box-shadow: 0 7px 25px rgba(16, 42, 67, 0.06);
      }

      .scripture-box p {
        margin: 0 0 5px;
        color: var(--dark);
        font-family: Georgia, serif;
        font-size: 1.08rem;
        font-style: italic;
      }

      .scripture-box strong {
        color: var(--primary);
        font-size: 0.82rem;
      }

      /* VIDEO */

      .video-section {
        background: white;
      }

      .church-video {
        max-width: 1000px;
        margin: 0 auto;
        overflow: hidden;
        border-radius: 10px;
        background: #071d2d;
        box-shadow: 0 22px 55px rgba(0, 0, 0, 0.24);
      }

      .church-video video {
        display: block;
        width: 100%;
        height: auto;
        max-height: 650px;
        background: #000;
      }

      .video-caption {
        max-width: 850px;
        margin: 25px auto 0;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* MINISTRIES */

      .ministries {
        background: var(--light);
      }

      .ministry-intro {
        max-width: 760px;
        margin: -25px auto 45px;
        text-align: center;
        color: var(--muted);
        font-size: 1.04rem;
      }

      .ministry-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }

      .ministry-card {
        padding: 34px 28px;
        border-top: 3px solid transparent;
        border-radius: 8px;
        background: white;
        box-shadow: 0 7px 25px rgba(16, 42, 67, 0.07);
        transition: 0.25s ease;
      }

      .ministry-card:hover {
        border-top-color: var(--secondary);
        transform: translateY(-5px);
        box-shadow: var(--shadow);
      }

      .ministry-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border-radius: 50%;
        background: #edf5fb;
        font-size: 1.45rem;
      }

      .ministry-card h3 {
        margin-bottom: 9px;
        color: var(--dark);
        font-size: 1.2rem;
      }

      .ministry-card p {
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* PASTOR */

      .pastor {
        background: white;
      }

      .pastor-grid {
        max-width: 1000px;
        display: grid;
        grid-template-columns: 390px 1fr;
        gap: 60px;
        align-items: center;
        margin: 0 auto;
      }

      .pastor-image img {
        width: 100%;
        height: 500px;
        object-fit: cover;
        object-position: center top;
        border-radius: 8px;
        box-shadow: var(--shadow);
      }

      .pastor-content .eyebrow {
        color: var(--secondary);
        font-size: 0.82rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .pastor-content h2 {
        margin: 7px 0 4px;
        color: var(--dark);
        font-size: 2.55rem;
        line-height: 1.15;
      }

      .pastor-role {
        margin-bottom: 22px;
        color: var(--primary);
        font-weight: 800;
      }

      .pastor-content p {
        margin-bottom: 16px;
      }

      .qualification {
        margin-top: 24px;
        padding: 18px 20px;
        border-left: 4px solid var(--primary);
        background: var(--light);
      }

      .qualification strong {
        display: block;
        color: var(--dark);
      }

      /* FAMILY */

      .family {
        background: var(--primary);
        color: white;
      }

      .family .section-title span {
        color: var(--secondary);
      }

      .family .section-title h2,
      .family .section-title p {
        color: white;
      }

      .family-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }

      .family-card {
        padding: 37px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
      }

      .family-card strong {
        display: block;
        margin-bottom: 3px;
        color: var(--secondary);
        font-size: 2.5rem;
        line-height: 1.1;
      }

      .family-card h3 {
        margin-bottom: 10px;
        color: white;
        font-size: 1.3rem;
      }

      .family-card p {
        color: rgba(255, 255, 255, 0.84);
      }

      .family-scripture {
        max-width: 750px;
        margin: 40px auto 0;
        text-align: center;
        color: rgba(255, 255, 255, 0.92);
        font-family: Georgia, serif;
        font-size: 1.15rem;
        font-style: italic;
      }

      .family-scripture strong {
        display: block;
        margin-top: 6px;
        color: var(--secondary);
        font-family: Arial, sans-serif;
        font-size: 0.8rem;
        font-style: normal;
      }

      /* CHILDREN */

      .children {
        background: var(--light);
      }

      .children-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 55px;
        align-items: center;
      }

      .children-image img {
        width: 100%;
        height: 460px;
        object-fit: cover;
        border-radius: 8px;
        box-shadow: var(--shadow);
      }

      .children-content h2 {
        margin-bottom: 18px;
        color: var(--dark);
        font-size: 2.6rem;
        line-height: 1.15;
      }

      .children-content p {
        margin-bottom: 17px;
      }

      .children-scripture {
        margin: 24px 0;
        padding: 20px 22px;
        border-radius: 7px;
        background: white;
        box-shadow: 0 7px 25px rgba(16, 42, 67, 0.06);
      }

      .children-scripture p {
        margin: 0 0 5px;
        color: var(--dark);
        font-family: Georgia, serif;
        font-style: italic;
      }

      .children-scripture strong {
        color: var(--primary);
        font-size: 0.8rem;
      }

      /* SCHEDULE */

      .schedule {
        background: white;
      }

      .schedule-table {
        max-width: 950px;
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      .schedule-row {
        display: grid;
        grid-template-columns: 1fr 1.6fr 1fr;
        border-bottom: 1px solid var(--border);
      }

      .schedule-row:last-child {
        border-bottom: 0;
      }

      .schedule-row > div {
        padding: 17px 20px;
      }

      .schedule-head {
        background: var(--primary);
        color: white;
        font-weight: 800;
      }

      .schedule-row:not(.schedule-head):nth-child(even) {
        background: var(--light);
      }

      .schedule-row:not(.schedule-head) > div:first-child {
        color: var(--primary);
        font-weight: 800;
      }

      .schedule-note {
        max-width: 750px;
        margin: 30px auto 0;
        text-align: center;
        color: var(--muted);
        font-size: 0.95rem;
      }

      /* GALLERY */

      .gallery {
        background: var(--light);
      }

      .gallery-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
      }

      .gallery-item {
        height: 225px;
        overflow: hidden;
        border-radius: 6px;
        background: #ddd;
      }

      .gallery-item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
      }

      .gallery-item:hover img {

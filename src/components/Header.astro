<!-- Dropdown behavior -->
<script>
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>(".dropdown");

  dropdowns.forEach((dropdown) => {

    const summary = dropdown.querySelector("summary");
    const links = dropdown.querySelectorAll<HTMLAnchorElement>(".dropdown-menu a");

    // When one dropdown opens, close the others
    summary?.addEventListener("click", () => {
      dropdowns.forEach((otherDropdown) => {
        if (otherDropdown !== dropdown) {
          otherDropdown.open = false;
        }
      });
    });

    // When an item is selected, close the dropdown automatically
    links.forEach((link) => {
      link.addEventListener("click", () => {
        dropdown.open = false;
      });
    });

  });
</script>


